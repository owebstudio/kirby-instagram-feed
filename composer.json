{
  "name": "owebstudio/instagram-feed",
  "description": "Instagram feed on your website for Kirby 3, 4 & 5.",
  "version": "1.4.0",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-3",
    "kirby-4",
    "kirby-5",
    "kirby3-plugin",
    "kirby4-plugin",
    "kirby5-plugin",
    "kirby-plugin",
    "kirby-instagram",
    "instagram",
    "instagram-feed"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "owebstudio/kirby-license": "^1.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "installer-name": "kirby-instagram-feed"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
