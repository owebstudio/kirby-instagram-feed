{
  "name": "owebstudio/kirby-instagram-feed",
  "description": "Instagram feed on your website for Kirby.",
  "type": "kirby-plugin",
  "license": "proprietary",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-5",
    "kirby5-plugin",
    "kirby-plugin",
    "kirby-instagram",
    "instagram",
    "instagram-feed"
  ],
  "homepage": "https://github.com/owebstudio/kirby-instagram-feed",
  "support": {
    "issues": "https://github.com/owebstudio/kirby-instagram-feed/issues",
    "source": "https://github.com/owebstudio/kirby-instagram-feed"
  },
  "authors": [
    {
      "name": "oweb studio",
      "homepage": "https://github.com/owebstudio"
    }
  ],
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "owebstudio/kirby-license": "^1.0.1"
  },
  "conflict": {
    "getkirby/cms": "<5.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "installer-name": "kirby-instagram-feed",
    "kirby": {
      "compatible": "^5.0"
    }
  },
  "prefer-stable": true
}
