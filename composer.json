{
  "name": "owebstudio/instagram-feed",
  "description": "Instagram feed on your website for Kirby.",
  "version": "1.4.0",
  "type": "kirby-plugin",
  "license": "proprietary",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-5",
    "kirby5-plugin",
    "kirby-plugin",
    "kirby-instagram",
    "instagram",
    "instagram-feed"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "owebstudio/kirby-license": "^1.0"
  },
  "conflict": {
    "getkirby/cms": "<5.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "installer-name": "kirby-instagram-feed",
    "kirby": {
      "compatible": "^5.0"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
